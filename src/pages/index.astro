---
import BaseLayout from '../layouts/BaseLayout.astro';
import MinimalHome from '../themes/minimal/Home.astro';
import AnimeHome from '../themes/anime/Home.astro';
---

<BaseLayout title="supervivian | Portfolio">
  <!-- 两个主题同时渲染，JS 控制显隐 -->
  <div id="theme-minimal" class="theme-container theme-minimal" data-theme="minimal">
    <MinimalHome />
  </div>
  <div id="theme-anime" class="theme-container theme-anime" data-theme="anime" style="display:none">
    <AnimeHome />
  </div>

  <!-- 主题切换按钮 -->
  <div class="theme-switcher" id="themeSwitcher">
    <button class="switcher-btn" id="switcherBtn" aria-label="切换主题">
      <span class="switcher-icon" id="switcherIcon">🎨</span>
      <span class="switcher-label" id="switcherLabel">切换主题</span>
    </button>
  </div>
</BaseLayout>

<script>
  (function () {
    const THEME_KEY = 'supervivian-theme';
    const containers = {
      minimal: document.getElementById('theme-minimal'),
      anime: document.getElementById('theme-anime'),
    };
    const btn = document.getElementById('switcherBtn');
    const icon = document.getElementById('switcherIcon');
    const label = document.getElementById('switcherLabel');

    function activateTheme(name) {
      // 切换内容显隐
      Object.entries(containers).forEach(([key, el]) => {
        if (!el) return;
        el.style.display = key === name ? '' : 'none';
      });
      // 在 html 上标记当前主题
      document.documentElement.setAttribute('data-theme', name);
      // 更新按钮文案
      if (label && icon) {
        if (name === 'anime') {
          label.textContent = '简约风格';
          icon.textContent = '◐';
        } else {
          label.textContent = '二次元风';
          icon.textContent = '🌸';
        }
      }
      localStorage.setItem(THEME_KEY, name);
    }

    // 页面加载时恢复主题
    const saved = localStorage.getItem(THEME_KEY) || 'anime';
    activateTheme(saved);

    // 点击切换
    if (btn) {
      btn.addEventListener('click', function () {
        const current = document.documentElement.getAttribute('data-theme') || 'anime';
        const next = current === 'anime' ? 'minimal' : 'anime';
        activateTheme(next);
      });
    }
  })();
</script>

<style>
  /* 主题容器 */
  .theme-container {
    min-height: 100vh;
  }

  /* 动漫主题时覆盖 body 样式 */
  :global(html[data-theme="anime"]) body {
    background: linear-gradient(135deg, #0f0a1e 0%, #1a1040 30%, #2d1b69 60%, #6b2fa0 100%) !important;
    color: #f0e6ff !important;
    font-family: 'PingFang SC', 'Noto Sans SC', 'Microsoft YaHei', sans-serif !important;
  }

  /* 简约主题恢复默认 */
  :global(html[data-theme="minimal"]) body {
    background: var(--bg-color) !important;
    color: var(--text-primary) !important;
    font-family: 'Georgia', 'Times New Roman', serif !important;
  }

  /* 切换按钮 */
  .theme-switcher {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
  }

  .switcher-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border: none;
    border-radius: 30px;
    cursor: pointer;
    font-size: 14px;
    font-family: inherit;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(8px);
    
    /* 动画主题下的按钮样式 */
    background: rgba(255, 255, 255, 0.12);
    color: #f0e6ff;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  :global(html[data-theme="minimal"]) .switcher-btn {
    background: rgba(45, 52, 54, 0.9);
    color: #faf8f5;
    border: 1px solid var(--border-color);
  }

  .switcher-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3);
  }

  .switcher-icon {
    font-size: 18px;
    line-height: 1;
  }

  .switcher-label {
    font-size: 13px;
    letter-spacing: 1px;
  }

  @media (max-width: 480px) {
    .theme-switcher {
      bottom: 16px;
      right: 16px;
    }
    .switcher-btn {
      padding: 8px 16px;
    }
    .switcher-label {
      display: none;
    }
  }
</style>

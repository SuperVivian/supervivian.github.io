---
import BaseLayout from '../layouts/BaseLayout.astro';
import { works } from '../data/works';
import { dockItems } from '../data/dock';
---

<BaseLayout title="supervivian">
  <main class="mobile-home">
    <div class="phone-frame">
      <!-- 状态栏 -->
      <header class="status-bar" aria-label="状态栏">
        <span class="status-time" id="statusTime">12:00</span>
        <div class="status-icons">
          <span class="signal" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </span>
          <span class="battery" aria-label="电池电量">100%</span>
        </div>
      </header>

      <!-- 主屏 -->
      <div class="home-screen">
        <div class="wallpaper" aria-hidden="true"></div>

        <section class="profile-card" aria-label="个人简介">
          <div class="avatar">
            <img src="/assets/icons/avatar.svg?v=2" alt="" loading="lazy" />
          </div>
          <h1 class="profile-name">supervivian</h1>
          <p class="profile-desc">Creative Programmer</p>
        </section>

        <section class="app-grid" aria-label="作品应用">
          {works.map((work) => {
            const isExternal = work.href.startsWith('http');
            const Tag = work.isEmpty ? 'button' : 'a';
            return (
              <Tag
                class={`app-item ${work.isEmpty ? 'app-item--empty' : ''}`}
                type={work.isEmpty ? 'button' : undefined}
                href={work.isEmpty ? undefined : work.href}
                target={work.isEmpty || !isExternal ? undefined : '_blank'}
                rel={work.isEmpty || !isExternal ? undefined : 'noopener noreferrer'}
                data-title={work.title}
                data-desc={work.description}
                data-color={work.color}
                data-icon={work.icon}
                data-empty={work.isEmpty ? 'true' : 'false'}
                aria-label={work.title}
              >
                <span class="app-icon" style={`background-color: ${work.color}; --icon-shadow: ${work.color}88`}>
                  <img src={work.icon} alt="" loading="lazy" />
                </span>
                <span class="app-name">{work.title}</span>
              </Tag>
            );
          })}
        </section>
      </div>

      <!-- Dock -->
      <nav class="dock" aria-label="常用入口">
        {dockItems.map((item) => {
          const isExternal = item.href.startsWith('http');
          return (
            <a
              class={`dock-item ${item.isModal ? 'dock-item--modal' : ''}`}
              href={item.href}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
              data-title={item.title}
              data-desc={item.desc || item.title}
              data-href={item.href}
              data-color={item.color}
              data-icon={item.icon}
            >
              <span class="app-icon" style={`background-color: ${item.color}; --icon-shadow: ${item.color}88`}>
                <img src={item.icon} alt="" loading="lazy" />
              </span>
              <span class="app-name">{item.title}</span>
            </a>
          );
        })}
      </nav>
    </div>
  </main>

  <!-- 应用详情弹窗 -->
  <div class="app-modal" id="appModal" aria-hidden="true">
    <div class="app-modal-backdrop"></div>
    <div class="app-modal-card" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <button class="modal-close" id="modalClose" aria-label="关闭">×</button>
      <div class="modal-header">
        <span class="modal-icon" id="modalIcon">
          <img src="" alt="" />
        </span>
        <h2 class="modal-title" id="modalTitle"></h2>
      </div>
      <p class="modal-desc" id="modalDesc"></p>
      <a class="modal-link" id="modalLink" href="#" target="_blank" rel="noopener noreferrer">
        打开应用 →
      </a>
    </div>
  </div>
</BaseLayout>

<script>
  (function () {
    const apps = document.querySelectorAll('.app-item');
    const dockItems = document.querySelectorAll('.dock-item');
    const modal = document.getElementById('appModal');
    const backdrop = modal?.querySelector('.app-modal-backdrop');
    const closeBtn = document.getElementById('modalClose');
    const iconEl = document.getElementById('modalIcon');
    const iconImg = iconEl?.querySelector('img');
    const titleEl = document.getElementById('modalTitle');
    const descEl = document.getElementById('modalDesc');
    const linkEl = document.getElementById('modalLink');
    const timeEl = document.getElementById('statusTime');

    function updateTime() {
      if (!timeEl) return;
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      timeEl.textContent = `${h}:${m}`;
    }
    updateTime();
    setInterval(updateTime, 1000);

    function openModal(data: {
      title: string;
      desc: string;
      href: string;
      color: string;
      icon: string;
      isEmpty: boolean;
    }) {
      if (!modal || !iconEl || !iconImg || !titleEl || !descEl || !linkEl) return;
      iconImg.src = data.icon;
      iconEl.style.backgroundColor = data.color;
      titleEl.textContent = data.title;
      descEl.textContent = data.desc;
      linkEl.href = data.href;
      linkEl.style.backgroundColor = data.color;
      linkEl.textContent = data.isEmpty ? '敬请期待' : '打开应用 →';
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    apps.forEach((app) => {
      app.addEventListener('click', (e) => {
        const el = app as HTMLElement;
        if (el.dataset.empty !== 'true') return;
        e.preventDefault();
        openModal({
          title: el.dataset.title || '',
          desc: el.dataset.desc || '',
          href: el.dataset.href || '#',
          color: el.dataset.color || '#666',
          icon: el.dataset.icon || '',
          isEmpty: true,
        });
      });
    });

    dockItems.forEach((item) => {
      item.addEventListener('click', (e) => {
        const el = item as HTMLElement;
        if (el.classList.contains('dock-item--modal')) {
          e.preventDefault();
        }
        openModal({
          title: el.dataset.title || '',
          desc: el.dataset.desc || '',
          href: el.dataset.href || '#',
          color: el.dataset.color || '#666',
          icon: el.dataset.icon || '',
          isEmpty: el.classList.contains('dock-item--modal'),
        });
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  })();
</script>

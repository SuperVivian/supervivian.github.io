---
import BaseLayout from '../layouts/BaseLayout.astro';

const weeklyItems = [
  { id: '2025-week26', title: '2025 Week 26', file: '/weekly/report_2025_week26.html' },
  { id: '2026-week27', title: '2026 Week 27', file: '/weekly/report_2026_week27.html' },
];
---

<BaseLayout title="Weekly | supervivian">
  <div class="weekly-page">
    <aside class="weekly-sidebar" aria-label="周报菜单">
      <a class="weekly-back" href="/" aria-label="返回首页">
        ← 首页
      </a>
      <nav class="weekly-menu" aria-label="周报列表">
        {weeklyItems.map((item, index) => (
          <button
            class={`weekly-menu-item ${index === 0 ? 'is-active' : ''}`}
            type="button"
            data-file={`${item.file}?v=2`}
            data-index={index}
            aria-label={item.title}
          >
            <span class="menu-dot" style={`background-color: ${index % 2 === 0 ? '#F4BFBF' : '#AED9F1'}`}></span>
            <span class="menu-title">{item.title}</span>
          </button>
        ))}
      </nav>
    </aside>

    <main class="weekly-content">
      <iframe
        id="weeklyFrame"
        class="weekly-frame"
        src={`${weeklyItems[0].file}?v=2`}
        title="周报内容"
        loading="lazy"
      ></iframe>
    </main>
  </div>
</BaseLayout>

<script>
  (function () {
    const menuItems = document.querySelectorAll('.weekly-menu-item');
    const frame = document.getElementById('weeklyFrame') as HTMLIFrameElement | null;

    menuItems.forEach((item) => {
      item.addEventListener('click', () => {
        const el = item as HTMLElement;
        const file = el.dataset.file;
        if (!frame || !file) return;

        menuItems.forEach((btn) => btn.classList.remove('is-active'));
        el.classList.add('is-active');
        frame.src = file;
      });
    });
  })();
</script>

<style>
  .weekly-page {
    min-height: 100vh;
    display: flex;
    background:
      radial-gradient(ellipse 80% 70% at 15% 20%, rgba(255, 200, 210, 0.75) 0%, transparent 55%),
      radial-gradient(ellipse 70% 60% at 85% 30%, rgba(255, 230, 180, 0.65) 0%, transparent 50%),
      radial-gradient(ellipse 70% 70% at 70% 85%, rgba(200, 220, 255, 0.6) 0%, transparent 50%),
      radial-gradient(ellipse 60% 50% at 25% 90%, rgba(230, 200, 230, 0.55) 0%, transparent 45%),
      linear-gradient(180deg, #FFF7F5 0%, #FFF0F0 40%, #FDE8E8 70%, #FCE0E0 100%);
  }

  .weekly-sidebar {
    width: 220px;
    flex-shrink: 0;
    padding: 24px 16px;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(12px);
    border-right: 1px solid rgba(255, 255, 255, 0.6);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .weekly-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.7);
    color: #5D4E4A;
    font-size: 10px;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .weekly-back:hover {
    background: rgba(255, 255, 255, 0.9);
    transform: translateX(-2px);
  }

  .weekly-menu {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .weekly-menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 12px 14px;
    border: none;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.5);
    color: #5D4E4A;
    font-family: var(--font-pixel);
    font-size: 9px;
    text-align: left;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .weekly-menu-item:hover {
    background: rgba(255, 255, 255, 0.75);
    transform: translateX(3px);
  }

  .weekly-menu-item.is-active {
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 4px 12px rgba(141, 110, 110, 0.1);
  }

  .menu-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .menu-title {
    line-height: 1.4;
  }

  .weekly-content {
    flex: 1;
    padding: 24px;
    min-width: 0;
  }

  .weekly-frame {
    width: 100%;
    height: calc(100vh - 48px);
    border: none;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 12px 40px rgba(141, 110, 110, 0.12);
  }

  @media (max-width: 640px) {
    .weekly-page {
      flex-direction: column;
    }

    .weekly-sidebar {
      width: 100%;
      flex-direction: row;
      padding: 16px;
      border-right: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.6);
      overflow-x: auto;
    }

    .weekly-menu {
      flex-direction: row;
      gap: 8px;
    }

    .weekly-menu-item {
      width: auto;
      white-space: nowrap;
    }

    .weekly-content {
      padding: 16px;
    }

    .weekly-frame {
      height: calc(100vh - 140px);
    }
  }
</style>

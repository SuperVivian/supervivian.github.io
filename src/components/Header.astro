---

<header class="header">
  <div class="container header-content">
    <a href="/" class="logo">supervivian</a>
    <nav class="nav">
      <a href="/" class="nav-link">Works</a>
    </nav>
  </div>
</header>

<style>
  .header {
    padding: 24px 0;
    border-bottom: 2px solid var(--border-color);
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-size: 24px;
    font-weight: bold;
    letter-spacing: 2px;
  }

  .nav {
    display: flex;
    gap: 32px;
  }

  .nav-link {
    font-size: 16px;
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--border-color);
    transition: width 0.3s ease;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  @media (max-width: 480px) {
    .logo {
      font-size: 20px;
    }

    .nav-link {
      font-size: 14px;
    }
  }
</style>

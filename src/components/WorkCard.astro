---
interface Props {
  title: string;
  description: string;
  href: string;
  preview: string;
  color: 'yellow' | 'cyan' | 'pink' | 'purple';
}

const { title, description, href, preview, color } = Astro.props;

const colorMap = {
  yellow: { accent: '#f39c12' },
  cyan: { accent: '#00b4d8' },
  pink: { accent: '#e07a8e' },
  purple: { accent: '#9b59b6' },
};

const colors = colorMap[color];
---

<a href={href} class="work-card" target="_blank">
  <div class="card-preview">
    <img src={preview} alt={title} class="preview-img" draggable="false" />
    <div class="hover-overlay">
      <span class="view-text">View →</span>
    </div>
  </div>
  <div class="card-content">
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{description}</p>
    <span class="card-tag">Web</span>
  </div>
</a>

<style>
  .work-card {
    display: block;
    background: var(--card-bg);
    border: 2px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .work-card:hover {
    transform: translateY(-8px);
    box-shadow: 8px 8px 0 var(--border-color);
  }

  .card-preview {
    height: 200px;
    position: relative;
    overflow: hidden;
    background: #f5f5f5;
  }

  .preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
  }

  .work-card:hover .preview-img {
    transform: scale(1.05);
  }

  .hover-overlay {
    position: absolute;
    inset: 0;
    background: rgba(45, 52, 54, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .work-card:hover .hover-overlay {
    opacity: 1;
  }

  .view-text {
    color: white;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 2px;
    padding: 12px 24px;
    border: 2px solid white;
    border-radius: 6px;
    transition: transform 0.3s ease;
  }

  .work-card:hover .view-text {
    transform: scale(1.1);
  }

  .card-content {
    padding: 20px;
    position: relative;
  }

  .card-title {
    font-size: 18px;
    margin-bottom: 8px;
  }

  .card-desc {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .card-tag {
    display: inline-block;
    font-size: 11px;
    padding: 4px 10px;
    background: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  @media (max-width: 480px) {
    .card-preview {
      height: 160px;
    }

    .card-content {
      padding: 16px;
    }

    .card-title {
      font-size: 16px;
    }
  }
</style>

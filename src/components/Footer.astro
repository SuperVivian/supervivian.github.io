---

<footer class="footer">
  <div class="container footer-content">
    <p class="footer-text">© 2026 supervivian</p>
    <div class="footer-decorations">
      <span class="dot"></span>
      <span class="dot"></span>
      <span class="dot"></span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 40px 0;
    margin-top: 80px;
    border-top: 2px solid var(--border-color);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-text {
    font-size: 14px;
    color: var(--text-secondary);
  }

  .footer-decorations {
    display: flex;
    gap: 8px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border: 2px solid var(--border-color);
    border-radius: 50%;
  }

  @media (max-width: 480px) {
    .footer-content {
      justify-content: center;
      gap: 16px;
    }

    .footer-decorations {
      order: -1;
    }
  }
</style>

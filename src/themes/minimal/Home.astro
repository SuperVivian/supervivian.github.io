---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WorkCard from '../../components/WorkCard.astro';

const works = [
  {
    title: 'Christmas Night',
    description: '圣诞夜主题互动网页',
    href: '/works/christmas-night/index.html',
    preview: '/works/christmas-night/preview.png',
    color: 'yellow' as const,
  },
  {
    title: 'Persona Map',
    description: '人格大陆 · 幻想风格个人介绍',
    href: '/works/persona-map/index.html',
    preview: '/works/persona-map/preview.png',
    color: 'cyan' as const,
  },
  {
    title: '编译原理入门',
    description: '从零学习编译原理的笔记站点',
    href: 'https://supervivian.github.io/compiler-intro/',
    preview: '/works/compiler-intro/preview.svg',
    color: 'purple' as const,
  },
];
---

<BaseLayout title="supervivian | Portfolio">
  <Header />

  <main>
    <section class="hero">
      <div class="container hero-content">
        <div class="hero-text">
          <h1 class="hero-title">Hi, I'm<br/>supervivian</h1>
          <p class="hero-subtitle">Creative Programmer & Designer</p>
        </div>
        <div class="hero-image">
          <img src="/hero.svg" alt="Hero Illustration" />
        </div>
      </div>

      <div class="deco deco-1"></div>
      <div class="deco deco-2"></div>
      <div class="deco deco-3"></div>
    </section>

    <section class="works">
      <div class="container">
        <h2 class="section-title">
          <span class="title-text">Works</span>
          <span class="title-line"></span>
        </h2>

        <div class="works-grid">
          {works.map((work) => (
            <WorkCard {...work} />
          ))}
        </div>

        <p class="works-hint">更多作品持续更新中...</p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hero {
    padding: 80px 0;
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .hero-title {
    font-size: 64px;
    line-height: 1.1;
    margin-bottom: 16px;
    letter-spacing: 4px;
  }

  .hero-subtitle {
    font-size: 20px;
    color: var(--text-secondary);
  }

  .hero-image {
    display: flex;
    justify-content: center;
  }

  .hero-image img {
    max-width: 100%;
    height: auto;
  }

  .deco {
    position: absolute;
    border: 2px solid var(--border-color);
  }

  .deco-1 {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    top: 20%;
    right: 10%;
  }

  .deco-2 {
    width: 40px;
    height: 40px;
    top: 60%;
    right: 15%;
    transform: rotate(45deg);
  }

  .deco-3 {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--accent-pink);
    top: 30%;
    right: 25%;
  }

  .works {
    padding: 60px 0;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 48px;
  }

  .title-text {
    font-size: 32px;
    letter-spacing: 4px;
  }

  .title-line {
    flex: 1;
    height: 2px;
    background: var(--border-color);
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
  }

  .works-hint {
    text-align: center;
    margin-top: 48px;
    font-size: 14px;
    color: var(--text-secondary);
    font-style: italic;
  }

  @media (max-width: 900px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-title {
      font-size: 48px;
    }

    .hero-image {
      order: -1;
    }

    .hero-image img {
      max-width: 300px;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: 40px 0;
    }

    .hero-title {
      font-size: 36px;
    }

    .hero-subtitle {
      font-size: 16px;
    }

    .works-grid {
      grid-template-columns: 1fr;
    }

    .deco {
      display: none;
    }
  }
</style>

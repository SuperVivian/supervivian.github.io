---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';

const works = [
  {
    title: 'Christmas Night',
    description: '圣诞夜主题互动网页',
    href: '/works/christmas-night/index.html',
    preview: '/works/christmas-night/preview-anime.png',
    color: 'yellow' as const,
  },
  {
    title: 'Persona Map',
    description: '人格大陆 · 幻想风格个人介绍',
    href: '/works/persona-map/index.html',
    preview: '/works/persona-map/preview-anime.png',
    color: 'cyan' as const,
  },
];
---

<BaseLayout title="supervivian | Portfolio">
  <!-- 樱花飘落动画容器 -->
  <div class="sakura-container">
    <div class="petal" style="--x: 10%; --delay: 0s; --size: 18px; --drift: 80px;"></div>
    <div class="petal" style="--x: 25%; --delay: 2s; --size: 14px; --drift: -60px;"></div>
    <div class="petal" style="--x: 40%; --delay: 4s; --size: 22px; --drift: 100px;"></div>
    <div class="petal" style="--x: 55%; --delay: 1s; --size: 16px; --drift: -40px;"></div>
    <div class="petal" style="--x: 70%; --delay: 3s; --size: 20px; --drift: 70px;"></div>
    <div class="petal" style="--x: 85%; --delay: 5s; --size: 12px; --drift: -90px;"></div>
    <div class="petal" style="--x: 15%; --delay: 6s; --size: 17px; --drift: 50px;"></div>
    <div class="petal" style="--x: 50%; --delay: 7s; --size: 15px; --drift: -70px;"></div>
    <div class="petal" style="--x: 35%; --delay: 8s; --size: 19px; --drift: 60px;"></div>
    <div class="petal" style="--x: 65%; --delay: 9s; --size: 13px; --drift: -50px;"></div>
  </div>

  <!-- 背景装饰 -->
  <div class="bg-circle circle-1"></div>
  <div class="bg-circle circle-2"></div>
  <div class="bg-grid"></div>

  <!-- 自定义 Header -->
  <header class="anime-header">
    <div class="container header-inner">
      <a href="/" class="anime-logo">
        <span class="logo-en">supervivian</span>
      </a>
      <nav class="anime-nav">
        <a href="/" class="nav-item active">首页</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="container hero-inner">
        <div class="hero-text">
          <p class="hero-greeting">你好呀～</p>
          <h1 class="hero-title">
            <span class="title-line-jp">创造中～</span>
            <span class="title-main">supervivian</span>
          </h1>
          <p class="hero-subtitle">Creative Programmer & Designer</p>
          <div class="hero-tags">
            <span class="tag">Frontend</span>
            <span class="tag">Design</span>
            <span class="tag">Animation</span>
          </div>
        </div>
        <div class="hero-visual">
          <div class="avatar-ring">
            <div class="avatar-glow"></div>
            <img src="/hero-anime.png" alt="supervivian" class="avatar-img" />
          </div>
        </div>
      </div>
    </section>

    <!-- Works Section -->
    <section class="works">
      <div class="container">
        <div class="works-header">
          <span class="works-label-jp">作品集</span>
          <h2 class="works-title">Works</h2>
          <p class="works-desc">之前的创作们～</p>
        </div>

        <div class="works-grid">
          {works.map((work) => (
            <WorkCard {...work} />
          ))}
        </div>

        <p class="works-hint">— 未完待续 —</p>
      </div>
    </section>
  </main>

  <!-- 自定义 Footer -->
  <footer class="anime-footer">
    <div class="container footer-inner">
      <div class="footer-divider">
        <span class="divider-star">✦</span>
      </div>
      <p class="footer-text">© 2026 supervivian</p>
      <p class="footer-sub">— 谢谢你呀 —</p>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ==============================
     根/基础变量
     ============================== */
  .hero,
  .works,
  .anime-header,
  .anime-footer {
    position: relative;
    z-index: 1;
  }

  /* ==============================
     背景
     ============================== */

  .bg-circle {
    position: fixed;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.15;
    pointer-events: none;
    z-index: 0;
  }

  .circle-1 {
    width: 500px;
    height: 500px;
    background: #ff6b9d;
    top: -100px;
    right: -100px;
    animation: float-slow 8s ease-in-out infinite alternate;
  }

  .circle-2 {
    width: 400px;
    height: 400px;
    background: #7c4dff;
    bottom: -100px;
    left: -100px;
    animation: float-slow 10s ease-in-out infinite alternate-reverse;
  }

  .bg-grid {
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
    z-index: 0;
  }

  @keyframes float-slow {
    0% { transform: translate(0, 0); }
    100% { transform: translate(30px, 30px); }
  }

  /* ==============================
     樱花飘落
     ============================== */
  .sakura-container {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    overflow: hidden;
  }

  .petal {
    position: absolute;
    top: -30px;
    left: var(--x);
    width: var(--size);
    height: calc(var(--size) * 0.85);
    background: radial-gradient(ellipse at 30% 30%, #ffb7c5, #ff8fab);
    border-radius: 50% 0 50% 0;
    opacity: 0.6;
    animation: fall linear infinite;
    animation-duration: 10s;
    animation-delay: var(--delay);
  }

  @keyframes fall {
    0% {
      transform: translateY(0) translateX(0) rotate(0deg);
      opacity: 0.6;
    }
    100% {
      transform: translateY(110vh) translateX(var(--drift)) rotate(720deg);
      opacity: 0;
    }
  }

  /* ==============================
     Header
     ============================== */
  .anime-header {
    padding: 20px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
    background: rgba(15, 10, 30, 0.6);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .anime-logo {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .logo-jp {
    font-size: 12px;
    color: #ff8fab;
    letter-spacing: 3px;
    font-weight: 300;
  }

  .logo-en {
    font-size: 22px;
    font-weight: bold;
    letter-spacing: 3px;
    background: linear-gradient(90deg, #f0e6ff, #ff8fab);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .anime-nav {
    display: flex;
    gap: 24px;
  }

  .nav-item {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.3s;
    letter-spacing: 2px;
  }

  .nav-item:hover,
  .nav-item.active {
    color: #ff8fab;
  }

  /* ==============================
     Hero
     ============================== */
  .hero {
    padding: 100px 0 80px;
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hero-greeting {
    font-size: 16px;
    color: #ff8fab;
    letter-spacing: 8px;
    margin-bottom: 8px;
    font-weight: 300;
  }

  .hero-title {
    margin-bottom: 16px;
  }

  .title-line-jp {
    display: block;
    font-size: 28px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 12px;
    margin-bottom: 8px;
  }

  .title-main {
    display: block;
    font-size: 72px;
    font-weight: bold;
    line-height: 1.1;
    letter-spacing: 6px;
    background: linear-gradient(135deg, #f0e6ff, #ff8fab, #ff6b9d);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradient-shift 4s ease infinite;
    background-size: 200% 200%;
  }

  @keyframes gradient-shift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .hero-subtitle {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 24px;
    letter-spacing: 4px;
  }

  .hero-tags {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .tag {
    display: inline-block;
    padding: 6px 16px;
    border: 1px solid rgba(255, 143, 171, 0.4);
    border-radius: 20px;
    font-size: 12px;
    color: #ff8fab;
    letter-spacing: 2px;
    transition: all 0.3s;
  }

  .tag:hover {
    background: rgba(255, 143, 171, 0.15);
    border-color: #ff8fab;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .avatar-ring {
    position: relative;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-glow {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, #ff6b9d, #7c4dff, #ff6b9d, #7c4dff, #ff6b9d);
    opacity: 0.3;
    animation: spin 6s linear infinite;
    filter: blur(8px);
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .avatar-img {
    position: relative;
    width: 280px;
    height: auto;
    filter: drop-shadow(0 0 30px rgba(255, 143, 171, 0.3));
    animation: levitate 4s ease-in-out infinite;
  }

  @keyframes levitate {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  /* ==============================
     Works
     ============================== */
  .works {
    padding: 80px 0;
  }

  .works-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .works-label-jp {
    display: block;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 8px;
    margin-bottom: 8px;
  }

  .works-title {
    font-size: 36px;
    letter-spacing: 8px;
    margin-bottom: 8px;
  }

  .works-desc {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 3px;
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
  }

  .works-hint {
    text-align: center;
    margin-top: 48px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 4px;
  }

  /* ==============================
     Footer
     ============================== */
  .anime-footer {
    padding: 40px 0;
  }

  .footer-inner {
    text-align: center;
  }

  .footer-divider {
    margin-bottom: 24px;
  }

  .divider-star {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.2);
    animation: pulse-star 2s ease-in-out infinite;
  }

  @keyframes pulse-star {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 0.8; }
  }

  .footer-text {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 2px;
  }

  .footer-sub {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.2);
    margin-top: 4px;
    letter-spacing: 4px;
  }

  /* ==============================
     响应式
     ============================== */
  @media (max-width: 900px) {
    .hero {
      padding: 60px 0;
      min-height: auto;
    }

    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-tags {
      justify-content: center;
    }

    .hero-visual {
      order: -1;
    }

    .avatar-ring {
      width: 240px;
      height: 240px;
    }

    .avatar-img {
      width: 200px;
    }

    .title-main {
      font-size: 48px;
    }

    .title-line-jp {
      font-size: 22px;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: 40px 0;
    }

    .title-main {
      font-size: 36px;
    }

    .title-line-jp {
      font-size: 18px;
      letter-spacing: 6px;
    }

    .hero-subtitle {
      font-size: 15px;
    }

    .avatar-ring {
      width: 180px;
      height: 180px;
    }

    .avatar-img {
      width: 150px;
    }

    .works-grid {
      grid-template-columns: 1fr;
    }

    .logo-jp {
      font-size: 10px;
    }

    .logo-en {
      font-size: 18px;
    }
  }
</style>
